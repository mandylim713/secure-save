# ------------------------------------------------------------------
# Secure Save Hub - environment variables for Railway
# Paste these into Railway > your service > Variables.
# IMPORTANT: reuse the SAME APP_KEY that is in your current .env,
# otherwise existing encrypted data / 2FA secrets / sessions break.
# ------------------------------------------------------------------

APP_NAME="Secure Save"
APP_ENV=production
APP_KEY=base64:pGwNRHBYg+/GuUZ6N9GSfb+cFrCED+0t0yjl+E7OI0g=
APP_DEBUG=false
APP_URL=https://secure-savehub.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- MySQL (Railway MySQL plugin) ---
# Use Railway reference variables so they stay in sync automatically.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- Mail (your cPanel mailbox) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.secure-savehub.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Twilio (carry over from your current .env) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- BitPay (optional) ---
BITPAY_PRIVATE_KEY_PATH=/tmp/bitpay.pri
BITPAY_PUBLIC_KEY_PATH=/tmp/bitpay.pub
BITPAY_NETWORK=testnet
BITPAY_KEY_STORAGE_PASSWORD=SomeRandomePasswordForKeypairEncryption
BITPAY_TOKEN=
